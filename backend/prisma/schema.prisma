datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OWNER
  TENANT
}

enum ComplaintStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model User {
  id              String      @id @default(uuid())
  name            String
  email           String      @unique
  passwordHash    String
  phone           String
  role            Role        @default(TENANT)
  status          String      @default("active") // active | blocked
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  ownedProperties Property[]  @relation("OwnerProperties")
  tenantLease     Lease?
  complaints      Complaint[]
}

model Property {
  id              String      @id @default(uuid())
  ownerId         String
  owner           User        @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  location        String
  type            String
  totalRooms      Int
  amenities       String[]
  managerPhone    String
  createdAt       DateTime    @default(now())

  // Relations
  rooms           Room[]
  notices         Notice[]
  complaints      Complaint[]
  payments        Payment[]
}

model Room {
  id              String      @id @default(uuid())
  propertyId      String
  property        Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomNumber      String
  floor           Int         @default(1)
  capacity        Int         @default(2)
  occupied        Int         @default(0)
  rent            Float
  type            String      @default("Double Sharing")
  hasAC           Boolean     @default(false)
  hasAttachedBath Boolean     @default(false)
  createdAt       DateTime    @default(now())

  // Relations
  leases          Lease[]
}

model Lease {
  id              String      @id @default(uuid())
  tenantId        String      @unique
  tenant          User        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomId          String
  room            Room        @relation(fields: [roomId], references: [id])
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Float
  deposit         Float
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
}

model Payment {
  id              String         @id @default(uuid())
  propertyId      String
  property        Property       @relation(fields: [propertyId], references: [id])
  tenantId        String
  roomNumber      String
  month           String
  dueDate         DateTime
  amount          Float
  status          PaymentStatus  @default(PENDING)
  paymentDate     DateTime?
  paymentMethod   String?        // UPI, CARD, CASH
  transactionId   String?        @unique
  notes           String?
  createdAt       DateTime       @default(now())
}

model Complaint {
  id              String          @id @default(uuid())
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id])
  tenantId        String
  tenant          User            @relation(fields: [tenantId], references: [id])
  roomNumber      String
  category        String          // Plumbing, Electrical, Wi-Fi, Food, Housekeeping
  title           String
  description     String
  priority        Priority        @default(MEDIUM)
  status          ComplaintStatus @default(PENDING)
  assignedTo      String?
  assignedPhone   String?
  resolutionNotes String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Notice {
  id              String      @id @default(uuid())
  propertyId      String
  property        Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title           String
  category        String      // Maintenance, Announcement, Rules
  content         String
  author          String
  priority        String      @default("Normal")
  isPinned        Boolean     @default(false)
  createdAt       DateTime    @default(now())
}
